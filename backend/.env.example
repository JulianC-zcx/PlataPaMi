# Copia este archivo a ".env" y complétalo. NUNCA subas ".env" a GitHub.

# URL pública donde queda la carpeta "public" (sin barra final). Se usa en el enlace del correo "Restablecer contraseña".
# Local (XAMPP):  http://localhost/platapami_backend/public   (para abrir el enlace desde tu celular usa la IP de tu PC)
# Producción:     https://api.tudominio.com   (con el "document root" apuntando a la carpeta public)
APP_URL=http://localhost/platapami_backend/public

# Clave maestra (32 bytes en base64). Genera una con:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Cifra el número de documento. Si la pierdes no podrás abrir los extractos de usuarios existentes.
APP_KEY=

# ── MySQL ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=platapami
DB_USER=root
DB_PASS=

# ── Correo SMTP (Gmail: usa una "contraseña de aplicación") ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls          # tls (587) o ssl (465)
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
MAIL_FROM=tucorreo@gmail.com
MAIL_FROM_NAME=PlataPaMi
# smtp = envía de verdad · file = SOLO para pruebas: guarda cada correo como .eml en storage/mail (no envía nada)
MAIL_DRIVER=smtp

# ── Reglas ──
RESET_TTL_MIN=60         # minutos de vigencia del enlace de restablecimiento
SESSION_DAYS=30
TERMS_VERSION=1.0
APP_DEBUG=0              # 1 solo en desarrollo (muestra detalles de errores)
